# OpenSea API Anahtarları (Birden fazla key ile daha hızlı)
OPENSEA_API_KEY=your_opensea_api_key_here
OPENSEA_API_KEY_2=your_opensea_api_key_2_here
OPENSEA_API_KEY_3=your_opensea_api_key_3_here

# Ethereum Cüzdan Bilgileri
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Ağ Ayarları (mainnet veya testnet)
NETWORK=mainnet

# WETH Kontrat Adresi (Ağa göre değişir)
WETH_CONTRACT_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# RPC Sağlayıcı URLs (Birden fazla RPC ile daha stabil)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key
RPC_URL_2=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_2
RPC_URL_3=https://mainnet.infura.io/v3/your_infura_key

# Abstract Chain RPC URLs
ABSTRACT_RPC_URL=https://abstract-mainnet.g.alchemy.com/v2/your_alchemy_api_key
ABSTRACT_RPC_URL_2=https://abstract-mainnet.g.alchemy.com/v2/your_alchemy_api_key_2
ABSTRACT_RPC_URL_3=https://abstract-mainnet.g.alchemy.com/v2/your_alchemy_api_key_3

# Test Modu (true yapıldığında gerçek işlem yapmaz)
TEST_MODE=false
